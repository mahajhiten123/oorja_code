<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.2</version>
        <relativePath/>
    </parent>

    <groupId>com.oorja</groupId>
    <artifactId>oorja-backend</artifactId>
    <version>1.0.0</version>
    <name>oorja-backend</name>
    <description>Oorja on Move - Solar Field Operations Backend</description>

    <properties>
        <java.version>17</java.version>
        <jjwt.version>0.12.6</jjwt.version>
        <aws.sdk.version>2.28.29</aws.sdk.version>
        <oorja.it.requireDocker>false</oorja.it.requireDocker>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- Retry/backoff around flaky external calls (Razorpay order creation,
             R2/S3 object storage) so a transient outage degrades gracefully
             instead of failing the request outright on the first blip. -->
        <dependency>
            <groupId>org.springframework.retry</groupId>
            <artifactId>spring-retry</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-aspects</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- JWT -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
            <version>${jjwt.version}</version>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <version>${jjwt.version}</version>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Razorpay -->
        <!-- OpenPDF — invoice / credit-note / service-report PDF rendering -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>1.3.35</version>
        </dependency>
        <dependency>
            <groupId>com.razorpay</groupId>
            <artifactId>razorpay-java</artifactId>
            <version>1.4.6</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Real-Postgres integration tests (concurrency can't be proven on H2: it has no row locks / partial indexes).
             Versions come from the Spring Boot BOM. Tests are skipped, not failed, when Docker isn't available. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Object storage (S3 / Cloudflare R2 / any S3-compatible bucket).
             Used by S3StorageProvider when app.storage.provider=s3. -->
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
            <version>${aws.sdk.version}</version>
            <exclusions>
                <!-- The SDK defaults to Netty for async; we only use the sync
                     client, so drop the async HTTP stack to keep the jar lean. -->
                <exclusion>
                    <groupId>software.amazon.awssdk</groupId>
                    <artifactId>netty-nio-client</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <finalName>oorja-backend</finalName>
        <plugins>
            <!-- Unit tests (*Test) run in `mvn test`; Testcontainers/API/concurrency tests (*IT) run in `mvn verify`.
                 Set -Doorja.it.requireDocker=true in CI so a missing Docker daemon fails the build instead of skipping the ITs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                <environmentVariables>
                    <!-- Test-only values so the context starts: SecurityStartupValidator refuses to boot without them. -->
                    <JWT_SECRET>test-only-jwt-secret-0123456789-abcdefghijklmnopqrstuv</JWT_SECRET>
                    <ADMIN_PASSWORD>Test-Only-Admin-Password-42</ADMIN_PASSWORD>
                    <MAIL_ENABLED>false</MAIL_ENABLED>
                </environmentVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                <environmentVariables>
                    <!-- Test-only values so the context starts: SecurityStartupValidator refuses to boot without them. -->
                    <JWT_SECRET>test-only-jwt-secret-0123456789-abcdefghijklmnopqrstuv</JWT_SECRET>
                    <ADMIN_PASSWORD>Test-Only-Admin-Password-42</ADMIN_PASSWORD>
                    <MAIL_ENABLED>false</MAIL_ENABLED>
                </environmentVariables>
                    <systemPropertyVariables>
                        <oorja.it.requireDocker>${oorja.it.requireDocker}</oorja.it.requireDocker>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
