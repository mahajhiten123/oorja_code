# Copy to .env (or set these in your deploy platform's secret manager).
# NEVER commit real values. The app refuses to start if the REQUIRED ones
# below are missing, too short, or a known weak/default value.

# ---------- REQUIRED: JWT signing secret ----------
# Minimum 32 characters, random. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# ---------- REQUIRED: admin console shared password ----------
# Minimum 12 characters. Must not be a common password. Generate with:
#   openssl rand -base64 24
ADMIN_PASSWORD=
ADMIN_EMAIL=admin@oorjaonmove.com

# ---------- REQUIRED: CORS ----------
# Comma-separated list of EXACT frontend origins allowed to send credentialed
# requests. Must never be "*" (the app refuses to start if it is), because
# combined with allowCredentials(true) that lets any website make
# authenticated requests on behalf of a logged-in user.
# Production example:
#   CORS_ALLOWED_ORIGINS=https://app.oorjaonmove.com,https://admin.oorjaonmove.com
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- Optional: token lifetimes ----------
# Access token: short by design (15 min). Refresh token: 30 days, rotated on
# every use and individually revocable.
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000

# ---------- Everything else (db, mail, razorpay, msg91) ----------
# See application.properties for the full list of ${VAR} placeholders.

# ---------- File storage ----------
# local -> writes to app.upload.dir. Dev / single-server only: files are lost
#          if the box is replaced and are invisible to a second app server.
# s3    -> S3, Cloudflare R2, MinIO, or any S3-compatible bucket. Use in prod.
STORAGE_PROVIDER=local
UPLOAD_DIR=uploads

# Required when STORAGE_PROVIDER=s3. Keep the bucket PRIVATE — files are
# streamed through our own authenticated endpoints so ownership checks apply.
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto".
# AWS S3: leave endpoint blank, set a real region (e.g. ap-south-1).
STORAGE_S3_BUCKET=
STORAGE_S3_REGION=auto
STORAGE_S3_ENDPOINT=
STORAGE_S3_ACCESS_KEY=
STORAGE_S3_SECRET_KEY=
STORAGE_S3_PATH_STYLE=true

# ---------- Attachment deletion ----------
# Deletes are soft. The row survives as the audit record; the stored object is
# destroyed only after this window, so an accidental delete stays recoverable.
ATTACHMENT_RETENTION_DAYS=30
ATTACHMENT_PURGE_CRON=0 15 3 * * *

# ---------- Google Sign-In ----------
# OAuth 2.0 Web client ID. Must match the frontend's VITE_GOOGLE_CLIENT_ID.
GOOGLE_CLIENT_ID=
