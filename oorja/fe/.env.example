# Copy this file to .env.local and fill in your real values.

# Razorpay publishable/test Key ID (safe to expose in frontend code).
# Get it from Razorpay Dashboard > Settings > API Keys.
VITE_RAZORPAY_KEY_ID=rzp_test_1234567890abcd

# Base URL of the Java backend (see the oorja-backend project).
VITE_API_BASE_URL=http://localhost:8080

# Google Sign-In: OAuth 2.0 *Web application* client ID from Google Cloud
# Console > APIs & Services > Credentials. Add your site's origin to
# "Authorized JavaScript origins" (e.g. http://localhost:5173 for dev).
# Leave blank to hide the "Continue with Google" button entirely.
# Must match the backend's GOOGLE_CLIENT_ID.
VITE_GOOGLE_CLIENT_ID=
